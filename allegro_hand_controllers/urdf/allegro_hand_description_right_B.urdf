<?xml version="1.0" ?>
<!-- =================================================================================== -->
<!-- |    The standalone right-hand, geared (type B) Allegro Hand.                       | -->
<!-- |                                                                                   | -->
<!-- |    The links and joints now live in allegro_hand_right_B_macro.xacro so the same    | -->
<!-- |    model can also be bolted onto an arm (see lbr_description/urdf/med14_allegro).    | -->
<!-- |    This file only roots that macro at a `world` link, which is what the standalone   | -->
<!-- |    bringup has always done. Everything downstream already runs this through xacro    | -->
<!-- |    (allegro_hand.launch.py uses Command(['xacro ', urdf_path])), so the .urdf         | -->
<!-- |    extension is kept for compatibility with the launch files and moveit config       | -->
<!-- |    that reference it by name.                                                       | -->
<!-- =================================================================================== -->
<robot name="allegro_hand_right" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:include filename="$(find allegro_hand_controllers)/urdf/allegro_hand_right_B_macro.xacro"/>

  <link name="world"/>

  <!-- 0.095 here would put the mount face at `world` rather than palm_link; the
       original file shipped that value commented out and 0.0 active, so keep 0.0. -->
  <xacro:allegro_hand_right_B parent="world">
    <origin xyz="0 0 0.0" rpy="0 0 0"/>
  </xacro:allegro_hand_right_B>

</robot>
